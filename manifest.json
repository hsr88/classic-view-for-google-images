{
  "manifest_version": 3,
  "name": "Classic View for Google Images™",
  "version": "0.4.0",
  "description": "Restores the classic horizontal grid layout in Google Images, brings back the View Image button, hover zoom, and hides clutter.",
  "permissions": ["storage"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Classic View for Google Images™",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.google.com/search*",
        "*://www.google.pl/search*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ]
}
