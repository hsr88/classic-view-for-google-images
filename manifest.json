{
  "manifest_version": 3,
  "name": "Classic View for Google Images™",
  "version": "0.5.3",
  "description": "Restore classic Google Images rows with hover zoom, View Image, size filters, AI image controls, and less clutter.",
  "permissions": ["storage", "activeTab"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Classic View for Google Images™",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
